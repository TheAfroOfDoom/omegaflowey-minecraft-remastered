dialog show @s {type: "minecraft:multi_action", title: {text: "Reef", color: "gray", italic: true}, body: {type: "minecraft:plain_message", contents: {text: "Change the linked screen's current page"}}, inputs: [{type: "minecraft:text", key: "index", width: 100, label: {text: "Page Index", color: "gray", italic: true, hover_event: {action: "show_text", value: "0-based indexing"}}, max_length: 6}], pause: false, actions: [{label: {text: "Change", color: "light_purple", bold: true}, width: 60, action: {type: "minecraft:dynamic/run_command", template: "function reef:api/remote/linked_remote/change_page {page: $(index)}"}}]}
