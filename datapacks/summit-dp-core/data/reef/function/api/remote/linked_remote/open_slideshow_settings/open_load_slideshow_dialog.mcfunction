dialog show @s {type: "minecraft:multi_action", title: {text: "Reef", color: "gray", italic: true}, body: {type: "minecraft:plain_message", contents: {text: "Load a slideshow to the linked screen"}}, inputs: [{type: "minecraft:text", key: "id", width: 100, label: {text: "Slideshow Identifier", color: "gray", italic: true, hover_event: {action: "show_text", value: ["Example: `ns:my_slideshow`\n", {text: "Do not input a single quote (') character", color: "red"}]}}}], pause: false, actions: [{label: {text: "Load", color: "light_purple", bold: true}, width: 40, action: {type: "minecraft:dynamic/run_command", template: "function reef:api/remote/linked_remote/load_slideshow {id: '$(id)'}"}}]}
